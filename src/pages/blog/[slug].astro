---
import Layout from '../../layouts/Layout.astro';
import { articles } from '../../data/articles';

export function getStaticPaths() {
	return articles.map((article) => ({
		params: { slug: article.slug },
	}));
}

const { slug } = Astro.params;
const article = articles.find(a => a.slug === slug)!;
const related = articles.filter(a => a.category === article.category && a.slug !== article.slug).slice(0, 3);

function slugifyHeading(text: string): string {
	return text
		.replace(/[^\u4e00-\u9fa5a-zA-Z0-9]+/g, '-')
		.toLowerCase()
		.replace(/^-|-$/g, '');
}

function escapeHtml(text: string): string {
	return text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
}

/** 轻量语法高亮：关键词紫、字符串黄绿、函数青、注释灰 */
function highlightCode(code: string, lang = ''): string {
	const keywords: Record<string, string[]> = {
		python: ['import', 'from', 'as', 'def', 'class', 'return', 'if', 'elif', 'else', 'for', 'while', 'in', 'not', 'and', 'or', 'with', 'try', 'except', 'True', 'False', 'None', 'lambda', 'pass', 'yield', 'async', 'await'],
		r: ['library', 'require', 'function', 'if', 'else', 'for', 'while', 'in', 'TRUE', 'FALSE', 'NULL', 'NA', 'return'],
		js: ['import', 'from', 'export', 'default', 'const', 'let', 'var', 'function', 'return', 'if', 'else', 'for', 'while', 'of', 'in', 'class', 'new', 'async', 'await', 'true', 'false', 'null'],
		ts: ['import', 'from', 'export', 'default', 'const', 'let', 'var', 'function', 'return', 'if', 'else', 'for', 'while', 'of', 'in', 'class', 'new', 'async', 'await', 'true', 'false', 'null', 'type', 'interface'],
		bash: ['if', 'then', 'fi', 'for', 'do', 'done', 'in', 'echo', 'cd', 'npm', 'npx'],
	};
	const key = lang.toLowerCase().replace(/^\./, '');
	const alias: Record<string, string> = { py: 'python', javascript: 'js', typescript: 'ts', shell: 'bash', sh: 'bash', zsh: 'bash' };
	const dictKey = alias[key] || (keywords[key] ? key : 'python');
	const kw = keywords[dictKey] || keywords.python;
	const hashComment = dictKey === 'python' || dictKey === 'r' || dictKey === 'bash';
	const kwList = kw.join('|');
	const highlightPlain = (plain: string) =>
		escapeHtml(plain)
			.replace(/\b([A-Za-z_][\w]*)\s*(?=\()/g, '<span class="tok-fn">$1</span>')
			.replace(new RegExp(`\\b(${kwList})\\b`, 'g'), '<span class="tok-kw">$1</span>');

	return code.split('\n').map((line) => {
		let codePart = line;
		let comment = '';
		const mark = hashComment ? '#' : '//';
		const idx = line.indexOf(mark);
		if (idx >= 0) {
			const before = line.slice(0, idx);
			const quoteCount = (before.match(/['"]/g) || []).length;
			if (quoteCount % 2 === 0) {
				codePart = before;
				comment = line.slice(idx);
			}
		}

		let html = '';
		let last = 0;
		const strRe = /(["'])(?:\\.|(?!\1).)*\1/g;
		for (const m of codePart.matchAll(strRe)) {
			if (m.index == null) continue;
			html += highlightPlain(codePart.slice(last, m.index));
			html += `<span class="tok-string">${escapeHtml(m[0])}</span>`;
			last = m.index + m[0].length;
		}
		html += highlightPlain(codePart.slice(last));
		if (comment) html += `<span class="tok-comment">${escapeHtml(comment)}</span>`;
		return html;
	}).join('\n');
}

function renderCodeBlock(lang: string | undefined, code: string): string {
	const body = highlightCode(code.replace(/\n$/, ''), lang || '');
	const label = lang ? `<span class="code-lang">${escapeHtml(lang)}</span>` : '';
	return `<div class="code-window my-5 overflow-hidden rounded-xl border border-white/10 shadow-soft">
		<div class="code-window-bar flex items-center gap-2 px-4 py-3">
			<span class="code-dot code-dot-red"></span>
			<span class="code-dot code-dot-yellow"></span>
			<span class="code-dot code-dot-green"></span>
			${label}
		</div>
		<pre class="code-window-body overflow-x-auto px-4 pb-4 pt-1"><code class="text-[13px] leading-[1.55] font-mono">${body}</code></pre>
	</div>`;
}

function renderInline(text: string): string {
	return text
		.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" class="text-primary underline underline-offset-2 hover:opacity-80" rel="noopener noreferrer">$1</a>')
		.replace(/\*\*(.+?)\*\*/g, '<strong class="font-semibold text-foreground">$1</strong>')
		.replace(/`([^`]+)`/g, '<code class="rounded bg-secondary px-1.5 py-0.5 text-sm font-mono text-primary">$1</code>');
}

function renderMarkdown(content: string): string {
	let html = content.replace(/\r\n/g, '\n');
	const blocks: string[] = [];
	const stash = (fragment: string) => {
		const key = `%%BLOCK_${blocks.length}%%`;
		blocks.push(fragment);
		return key;
	};

	// 先抽出代码块，避免后续按行处理把代码行包进 <p> 造成巨大行距
	html = html.replace(/```(\w+)?\n([\s\S]*?)```/g, (_, lang, code) => stash(renderCodeBlock(lang, code)));

	html = html.replace(/\$\$([\s\S]+?)\$\$/g, (_, formula) => {
		return stash(`<div class="my-4 overflow-x-auto rounded-xl border border-border bg-secondary/30 p-4 text-center font-mono text-sm">${escapeHtml(formula.trim())}</div>`);
	});


	html = html.replace(/^### (.+)$/gm, (_, text) => {
		return `<p class="rt-lead"><strong>${renderInline(text)}</strong></p>`;
	});
	html = html.replace(/^## (.+)$/gm, (_, text) => {
		const id = slugifyHeading(text);
		return `<h2 id="${id}" data-toc class="rt-section-title">${renderInline(text)}</h2>`;
	});

	html = html.replace(/^(?:- .+(?:\n|$))+/gm, (match) => {
		const items = match.trim().split('\n').map((line) => {
			return `<li>${renderInline(line.replace(/^- /, ''))}</li>`;
		}).join('');
		return `<ul class="rt-list">${items}</ul>`;
	});

	html = html.replace(/^(?:\d+\. .+(?:\n|$))+/gm, (match) => {
		const items = match.trim().split('\n').map((line) => {
			return `<li>${renderInline(line.replace(/^\d+\. /, ''))}</li>`;
		}).join('');
		return `<ol class="rt-list">${items}</ol>`;
	});

	html = html.replace(/^!\[([^\]]*)\]\(([^)]+)\)(?:\{([^}]+)\})?$/gm, (_, alt, src, caption) => {
		const cap = caption || alt;
		return stash(`<figure class="rt-fig">
			<img src="${escapeHtml(src)}" alt="${escapeHtml(alt)}" class="rt-fig-img" loading="lazy" />
			${cap ? `<figcaption>${escapeHtml(cap)}</figcaption>` : ''}
		</figure>`);
	});

	html = html.split('\n').map((line) => {
		const trimmed = line.trim();
		if (!trimmed) return '';
		if (trimmed.startsWith('<') || /^%%BLOCK_\d+%%$/.test(trimmed)) return trimmed;
		return `<p class="rt-p">${renderInline(trimmed)}</p>`;
	}).join('\n');

	return html.replace(/%%BLOCK_(\d+)%%/g, (_, i) => blocks[Number(i)]);
}

const renderedContent = renderMarkdown(article.content);

const headingMatches = [...renderedContent.matchAll(/<h2 id="([^"]+)"[^>]*>([\s\S]*?)<\/h2>/g)];
const tocItems = headingMatches.slice(0, 11).map(m => {
	const full = m[2].replace(/<[^>]+>/g, '');
	// 侧边目录只保留冒号前主标题，正文 h2 仍显示完整文案
	const text = full.replace(/[：:].*$/, '').trim();
	return { id: m[1], text };
});

const plainExcerpt = article.excerpt.replace(/\*\*(.+?)\*\*/g, '$1');

const searchIndex = articles
	.filter((a) => a.slug !== article.slug)
	.map((a) => ({
		slug: a.slug,
		title: a.title,
		excerpt: a.excerpt.replace(/\*\*(.+?)\*\*/g, '$1'),
		category: a.category,
		tags: a.tags,
		sameCategory: a.category === article.category,
		sharedTags: a.tags.filter((t) => article.tags.includes(t)).length,
	}));

const site = Astro.site ?? new URL('https://rstudyhub.online');
const articleUrl = new URL(`/blog/${article.slug}`, site).href;
const articleImage = article.cover
	? article.cover.startsWith('http://') || article.cover.startsWith('https://')
		? article.cover
		: new URL(article.cover, site).href
	: undefined;
const articleSchema = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: article.title,
	description: plainExcerpt,
	datePublished: article.date,
	dateModified: article.date,
	mainEntityOfPage: articleUrl,
	url: articleUrl,
	image: articleImage ? [articleImage] : undefined,
	articleSection: article.category,
	keywords: article.tags,
	inLanguage: 'zh-CN',
	author: {
		'@type': 'Organization',
		name: '知识专栏',
	},
	publisher: {
		'@type': 'Organization',
		name: '知识专栏',
	},
};
---

<Layout
	title={`${article.title} · 知识专栏`}
	description={plainExcerpt}
	image={article.cover}
	type="article"
	hideFooter
>
	<div class="rt-page">
		<div class="rt-shell">
			<aside class="rt-toc" aria-label="文章目录">
				<div class="rt-search">
					<label class="rt-search-label" for="rt-post-search">搜索文章</label>
					<div class="rt-search-field">
						<svg class="rt-search-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line>
						</svg>
						<input
							id="rt-post-search"
							type="search"
							placeholder="搜索相关帖子..."
							autocomplete="off"
							aria-controls="rt-search-results"
						/>
						<button type="button" id="rt-search-clear" class="rt-search-clear" hidden aria-label="清除搜索">×</button>
					</div>
					<div id="rt-search-results" class="rt-search-results" hidden role="listbox" aria-label="搜索结果"></div>
				</div>
				<p class="rt-toc-title">目录</p>
				<nav id="toc-nav">
					<ol>
						{tocItems.length > 0 ? tocItems.map((item) => (
							<li>
								<a href={`#${item.id}`} data-toc-link={item.id} class="toc-link">{item.text}</a>
							</li>
						)) : (
							<li><span class="rt-toc-empty">本文暂无目录</span></li>
						)}
					</ol>
				</nav>
				<div class="rt-toc-support">
					<p class="rt-toc-support-title">有帮助？请我喝杯咖啡</p>
					<button type="button" class="rt-toc-btn rt-toc-btn-wx" id="btn-wechat-tip">微信打赏</button>
					<button type="button" class="rt-toc-btn rt-toc-btn-qq" id="btn-open-qq" title="群号 1013137874">QQ学习交流群</button>
					<p class="rt-toc-hint">👆 点这里 · 进群一起学习</p>
				</div>
				<a href="/blog" class="rt-toc-back">← 返回博客</a>
			</aside>

			<main class="rt-content">
				<div class="rt-meta">
					<span class="rt-badge">{article.category}</span>
					<span>{article.date}</span>
					<span>· {article.readTime}</span>
				</div>
				<h1 class="rt-h1">{article.title}</h1>
				<p class="rt-excerpt" set:html={renderInline(article.excerpt)} />

				<div class="rt-prose" id="article-content" set:html={renderedContent} />

				{related.length > 0 && (
					<div class="rt-related">
						<h2 class="rt-section-title">相关文章</h2>
						<div class="rt-related-grid">
							{related.map(r => (
								<a href={`/blog/${r.slug}`} class="rt-related-card">
									<span>{r.category}</span>
									<strong>{r.title}</strong>
									<em>{r.excerpt}</em>
								</a>
							))}
						</div>
					</div>
				)}
			</main>
		</div>
	</div>

	<div class="rt-tip-modal" id="wechat-tip-modal">
		<div class="rt-tip-card" role="dialog" aria-modal="true" aria-label="微信打赏">
			<button type="button" class="rt-tip-close" id="btn-close-tip" aria-label="关闭">×</button>
			<h3>微信打赏</h3>
			<p>扫码请作者喝杯咖啡 ☕</p>
			<img src="/tutorials/r/install-2026/wechat-tip-qr.png" alt="微信打赏二维码" />
		</div>
	</div>

	<div class="rt-lightbox" id="rt-lightbox" role="dialog" aria-modal="true" aria-label="图片放大预览">
		<button type="button" class="rt-lightbox-close" id="rt-lightbox-close" aria-label="关闭">×</button>
		<img alt="" id="rt-lightbox-img" />
	</div>
	<script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
</Layout>

<style is:global>
	.rt-page {
		min-height: 100dvh;
		padding: 5.5rem 1.25rem 3.5rem;
		background: #eef1f6;
		color: #1a1d26;
		/* 中文沿用原先无衬线；英文优先 Times New Roman */
		font-family: "Times New Roman", Times, "Noto Sans SC", "Syne", sans-serif;
	}
	.rt-shell {
		max-width: 1120px;
		margin: 0 auto;
		display: grid;
		grid-template-columns: 240px minmax(0, 1fr);
		gap: 1.25rem;
		align-items: start;
	}
	@media (max-width: 900px) {
		.rt-shell { grid-template-columns: 1fr; }
		.rt-toc { position: static !important; max-height: none !important; }
	}
	.rt-toc {
		position: sticky;
		top: 5.25rem;
		background: #fff;
		border-radius: 16px;
		box-shadow: 0 8px 28px rgba(15, 23, 42, 0.06);
		border: 1px solid rgba(255, 255, 255, 0.7);
		padding: 1rem 0.9rem 1.1rem;
		max-height: calc(100dvh - 6rem);
		overflow: auto;
	}
	.rt-toc-title {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		font-weight: 800;
		font-size: 1.15rem;
		margin: 0 0 0.75rem 0.35rem;
	}
	.rt-toc-title::before {
		content: "";
		width: 4px;
		height: 1.05rem;
		border-radius: 2px;
		background: #2f6bff;
	}
	.rt-search {
		margin: 0 0 0.85rem;
		padding: 0 0.15rem 0.85rem;
		border-bottom: 1px dashed #e2e8f0;
	}
	.rt-search-label {
		display: block;
		margin: 0 0 0.45rem 0.2rem;
		font-size: 0.78rem;
		font-weight: 700;
		color: #5c6578;
	}
	.rt-search-field {
		position: relative;
		display: flex;
		align-items: center;
	}
	.rt-search-icon {
		position: absolute;
		left: 0.7rem;
		color: #8b93a7;
		pointer-events: none;
	}
	.rt-search-field input {
		width: 100%;
		padding: 0.55rem 2rem 0.55rem 2.15rem;
		border: 1px solid #e2e8f0;
		border-radius: 10px;
		background: #f7f9fc;
		font: inherit;
		font-size: 0.86rem;
		color: #1a1d26;
		outline: none;
		transition: border-color 0.15s, box-shadow 0.15s, background 0.15s;
	}
	.rt-search-field input::placeholder { color: #9aa3b5; }
	.rt-search-field input:focus {
		border-color: #2f6bff;
		background: #fff;
		box-shadow: 0 0 0 3px rgba(47, 107, 255, 0.12);
	}
	.rt-search-clear {
		position: absolute;
		right: 0.35rem;
		width: 1.5rem;
		height: 1.5rem;
		border: 0;
		border-radius: 999px;
		background: transparent;
		color: #8b93a7;
		font-size: 1.1rem;
		line-height: 1;
		cursor: pointer;
	}
	.rt-search-clear:hover { color: #243044; background: #eef1f6; }
	.rt-search-results {
		margin-top: 0.55rem;
		max-height: 14rem;
		overflow: auto;
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}
	.rt-search-hit {
		display: block;
		padding: 0.55rem 0.6rem;
		border-radius: 10px;
		text-decoration: none;
		color: inherit;
		background: #f7f9fc;
		border: 1px solid transparent;
		transition: background 0.15s, border-color 0.15s;
	}
	.rt-search-hit:hover {
		background: #e8efff;
		border-color: #c9dbff;
	}
	.rt-search-hit-cat {
		display: block;
		font-size: 0.72rem;
		font-weight: 600;
		color: #2f6bff;
		margin-bottom: 0.15rem;
	}
	.rt-search-hit-title {
		display: block;
		font-size: 0.84rem;
		font-weight: 700;
		line-height: 1.35;
		color: #1a1d26;
	}
	.rt-search-hit mark {
		background: rgba(47, 107, 255, 0.15);
		color: #1f5eff;
		border-radius: 3px;
		padding: 0 0.1em;
	}
	.rt-search-empty {
		padding: 0.55rem 0.4rem;
		font-size: 0.82rem;
		color: #8b93a7;
	}
	.rt-toc ol { list-style: none; margin: 0; padding: 0; }
	.rt-toc a.toc-link {
		display: block;
		color: #5c6578;
		font-size: 0.88rem;
		line-height: 1.45;
		padding: 0.45rem 0.55rem;
		border-radius: 10px;
		text-decoration: none;
		transition: background 0.15s, color 0.15s;
	}
	.rt-toc a.toc-link:hover,
	.rt-toc a.toc-link.is-active {
		background: #e8efff;
		color: #2f6bff;
		font-weight: 600;
	}
	.rt-toc-empty { color: #5c6578; font-size: 0.88rem; padding: 0.45rem; }
	.rt-toc-support {
		margin-top: 1rem;
		padding: 0.85rem 0.7rem 0.95rem;
		border-top: 1px dashed #e2e8f0;
		text-align: center;
	}
	.rt-toc-support-title {
		margin: 0 0 0.65rem;
		font-size: 0.88rem;
		font-weight: 700;
		color: #243044;
	}
	.rt-toc-btn {
		display: block;
		width: 100%;
		margin: 0.45rem 0 0;
		padding: 0.62rem 0.7rem;
		border-radius: 10px;
		border: 1px solid transparent;
		font-size: 0.95rem;
		font-weight: 700;
		cursor: pointer;
		font-family: inherit;
	}
	.rt-toc-btn-wx { background: #eaf7ef; color: #1f7a45; border-color: #b7e0c4; }
	.rt-toc-btn-wx:hover { background: #dff2e6; }
	.rt-toc-btn-qq { background: #e8f1ff; color: #1f5eff; border-color: #c9dbff; }
	.rt-toc-btn-qq:hover { background: #d9e8ff; }
	.rt-toc-hint {
		margin: 0.45rem 0 0;
		font-size: 0.86rem;
		font-weight: 700;
		color: #1f5eff;
	}
	.rt-toc-back {
		display: block;
		margin-top: 0.85rem;
		padding: 0.35rem 0.55rem;
		font-size: 0.82rem;
		color: #5c6578;
		text-decoration: none;
	}
	.rt-toc-back:hover { color: #2f6bff; }
	.rt-content {
		background: #fff;
		border-radius: 16px;
		box-shadow: 0 8px 28px rgba(15, 23, 42, 0.06);
		border: 1px solid rgba(255, 255, 255, 0.7);
		/* 底部留白：末节较短时也能滚到标题贴顶，目录高亮才能切到最后一项 */
		padding: 1.75rem 1.6rem min(55vh, 28rem);
		min-width: 0;
	}
	.rt-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.65rem;
		font-size: 0.85rem;
		color: #5c6578;
		margin-bottom: 0.85rem;
	}
	.rt-badge {
		display: inline-block;
		padding: 0.2rem 0.65rem;
		border-radius: 999px;
		background: #e8efff;
		color: #2f6bff;
		font-weight: 600;
		font-size: 0.8rem;
	}
	.rt-h1 {
		margin: 0;
		/* 标题：黑体 */
		font-family: "SimHei", "Heiti SC", "STHeiti", "Microsoft YaHei", "PingFang SC", "Noto Sans SC", sans-serif;
		font-size: clamp(1.45rem, 2.6vw, 1.95rem);
		font-weight: 800;
		line-height: 1.35;
		letter-spacing: -0.02em;
		color: #1a1d26;
	}
	.rt-excerpt {
		margin: 0.85rem 0 1.35rem;
		color: #5c6578;
		font-size: 0.98rem;
		line-height: 1.65;
	}
	.rt-prose .rt-section-title,
	.rt-related .rt-section-title {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		margin: 2rem 0 1rem;
		font-size: 1.28rem;
		font-weight: 800;
		line-height: 1.35;
		color: #1a1d26;
		scroll-margin-top: 6rem;
		font-family: "SimHei", "Heiti SC", "STHeiti", "Microsoft YaHei", "PingFang SC", "Noto Sans SC", sans-serif;
	}
	.rt-prose .rt-section-title:first-child { margin-top: 0.25rem; }
	.rt-prose .rt-section-title::before,
