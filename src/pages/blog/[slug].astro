---
import Layout from '../../layouts/Layout.astro';
import { articles } from '../../data/articles';

export function getStaticPaths() {
	return articles.map((article) => ({
		params: { slug: article.slug },
	}));
}

const { slug } = Astro.params;
const article = articles.find(a => a.slug === slug)!;
const related = articles.filter(a => a.category === article.category && a.slug !== article.slug).slice(0, 3);

function slugifyHeading(text: string): string {
	return text
		.replace(/[^\u4e00-\u9fa5a-zA-Z0-9]+/g, '-')
		.toLowerCase()
		.replace(/^-|-$/g, '');
}

function escapeHtml(text: string): string {
	return text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
}

/** 轻量语法高亮：关键词紫、字符串黄绿、函数青、注释灰 */
function highlightCode(code: string, lang = ''): string {
	const keywords: Record<string, string[]> = {
		python: ['import', 'from', 'as', 'def', 'class', 'return', 'if', 'elif', 'else', 'for', 'while', 'in', 'not', 'and', 'or', 'with', 'try', 'except', 'True', 'False', 'None', 'lambda', 'pass', 'yield', 'async', 'await'],
		r: ['library', 'require', 'function', 'if', 'else', 'for', 'while', 'in', 'TRUE', 'FALSE', 'NULL', 'NA', 'return'],
		js: ['import', 'from', 'export', 'default', 'const', 'let', 'var', 'function', 'return', 'if', 'else', 'for', 'while', 'of', 'in', 'class', 'new', 'async', 'await', 'true', 'false', 'null'],
		ts: ['import', 'from', 'export', 'default', 'const', 'let', 'var', 'function', 'return', 'if', 'else', 'for', 'while', 'of', 'in', 'class', 'new', 'async', 'await', 'true', 'false', 'null', 'type', 'interface'],
		bash: ['if', 'then', 'fi', 'for', 'do', 'done', 'in', 'echo', 'cd', 'npm', 'npx'],
	};
	const key = lang.toLowerCase().replace(/^\./, '');
	const alias: Record<string, string> = { py: 'python', javascript: 'js', typescript: 'ts', shell: 'bash', sh: 'bash', zsh: 'bash' };
	const dictKey = alias[key] || (keywords[key] ? key : 'python');
	const kw = keywords[dictKey] || keywords.python;
	const hashComment = dictKey === 'python' || dictKey === 'r' || dictKey === 'bash';
	const kwList = kw.join('|');
	const highlightPlain = (plain: string) =>
		escapeHtml(plain)
			.replace(/\b([A-Za-z_][\w]*)\s*(?=\()/g, '<span class="tok-fn">$1</span>')
			.replace(new RegExp(`\\b(${kwList})\\b`, 'g'), '<span class="tok-kw">$1</span>');

	return code.split('\n').map((line) => {
		let codePart = line;
		let comment = '';
		const mark = hashComment ? '#' : '//';
		const idx = line.indexOf(mark);
		if (idx >= 0) {
			const before = line.slice(0, idx);
			const quoteCount = (before.match(/['"]/g) || []).length;
			if (quoteCount % 2 === 0) {
				codePart = before;
				comment = line.slice(idx);
			}
		}

		let html = '';
		let last = 0;
		const strRe = /(["'])(?:\\.|(?!\1).)*\1/g;
		for (const m of codePart.matchAll(strRe)) {
			if (m.index == null) continue;
			html += highlightPlain(codePart.slice(last, m.index));
			html += `<span class="tok-string">${escapeHtml(m[0])}</span>`;
			last = m.index + m[0].length;
		}
		html += highlightPlain(codePart.slice(last));
		if (comment) html += `<span class="tok-comment">${escapeHtml(comment)}</span>`;
		return html;
	}).join('\n');
}

function renderCodeBlock(lang: string | undefined, code: string): string {
	const body = highlightCode(code.replace(/\n$/, ''), lang || '');
	const label = lang ? `<span class="code-lang">${escapeHtml(lang)}</span>` : '';
	return `<div class="code-window my-5 overflow-hidden rounded-xl border border-white/10 shadow-soft">
		<div class="code-window-bar flex items-center gap-2 px-4 py-3">
			<span class="code-dot code-dot-red"></span>
			<span class="code-dot code-dot-yellow"></span>
			<span class="code-dot code-dot-green"></span>
			${label}
		</div>
		<pre class="code-window-body overflow-x-auto px-4 pb-4 pt-1"><code class="text-[13px] leading-[1.55] font-mono">${body}</code></pre>
	</div>`;
}

function renderInline(text: string): string {
	return text
		.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" class="text-primary underline underline-offset-2 hover:opacity-80" rel="noopener noreferrer">$1</a>')
		.replace(/\*\*(.+?)\*\*/g, '<strong class="font-semibold text-foreground">$1</strong>')
		.replace(/`([^`]+)`/g, '<code class="rounded bg-secondary px-1.5 py-0.5 text-sm font-mono text-primary">$1</code>');
}

function renderMarkdown(content: string): string {
	let html = content.replace(/\r\n/g, '\n');
	const blocks: string[] = [];
	const stash = (fragment: string) => {
		const key = `%%BLOCK_${blocks.length}%%`;
		blocks.push(fragment);
		return key;
	};

	// 先抽出代码块，避免后续按行处理把代码行包进 <p> 造成巨大行距
	html = html.replace(/```(\w+)?\n([\s\S]*?)```/g, (_, lang, code) => stash(renderCodeBlock(lang, code)));

	html = html.replace(/\$\$([\s\S]+?)\$\$/g, (_, formula) => {
		return stash(`<div class="my-4 overflow-x-auto rounded-xl border border-border bg-secondary/30 p-4 text-center font-mono text-sm">${escapeHtml(formula.trim())}</div>`);
	});

	html = html.replace(/^### (.+)$/gm, (_, text) => {
		const id = slugifyHeading(text);
		return `<h3 id="${id}" data-toc class="text-xl font-bold mt-8 mb-3 scroll-mt-24">${renderInline(text)}</h3>`;
	});
	html = html.replace(/^## (.+)$/gm, (_, text) => {
		const id = slugifyHeading(text);
		return `<h2 id="${id}" data-toc class="text-2xl font-bold mt-10 mb-4 scroll-mt-24">${renderInline(text)}</h2>`;
	});

	html = html.replace(/^(?:- .+(?:\n|$))+/gm, (match) => {
		const items = match.trim().split('\n').map((line) => {
			return `<li class="ml-4 list-disc">${renderInline(line.replace(/^- /, ''))}</li>`;
		}).join('');
		return `<ul class="my-4 space-y-1.5 text-muted-foreground">${items}</ul>`;
	});

	html = html.replace(/^(?:\d+\. .+(?:\n|$))+/gm, (match) => {
		const items = match.trim().split('\n').map((line) => {
			return `<li class="ml-5 list-decimal">${renderInline(line.replace(/^\d+\. /, ''))}</li>`;
		}).join('');
		return `<ol class="my-4 space-y-1.5 text-muted-foreground">${items}</ol>`;
	});

	// 独立成行的图片 / GIF：![说明](url)
	html = html.replace(/^!\[([^\]]*)\]\(([^)]+)\)(?:\{([^}]+)\})?$/gm, (_, alt, src, caption) => {
		const cap = caption || alt;
		const isSvg = /\.svg$/i.test(src);
		const imgClass = isSvg ? 'w-full h-auto bg-[#f4f7f5]' : 'w-full object-cover';
		return stash(`<figure class="article-media my-6 overflow-hidden rounded-2xl border border-border bg-card">
			<img src="${escapeHtml(src)}" alt="${escapeHtml(alt)}" class="${imgClass}" loading="lazy" />
			${cap ? `<figcaption class="border-t border-border px-4 py-2.5 text-center text-sm text-muted-foreground">${escapeHtml(cap)}</figcaption>` : ''}
		</figure>`);
	});

	html = html.split('\n').map((line) => {
		const trimmed = line.trim();
		if (!trimmed) return '';
		if (trimmed.startsWith('<') || /^%%BLOCK_\d+%%$/.test(trimmed)) return trimmed;
		return `<p class="my-3 leading-relaxed text-muted-foreground">${renderInline(trimmed)}</p>`;
	}).join('\n');

	return html.replace(/%%BLOCK_(\d+)%%/g, (_, i) => blocks[Number(i)]);
}

const renderedContent = renderMarkdown(article.content);

const headingMatches = [...renderedContent.matchAll(/<h([23]) id="([^"]+)"[^>]*>([\s\S]*?)<\/h\1>/g)];
const tocItems = headingMatches.map(m => ({
	level: parseInt(m[1]),
	id: m[2],
	text: m[3].replace(/<[^>]+>/g, ''),
}));
---

<Layout
	title={`${article.title} · 知识专栏`}
	description={article.excerpt}
	image={article.cover}
	type="article"
	hideFooter
>
	<!-- Content stays centered; TOC sits immediately to its left -->
	<div class="flex h-dvh overflow-hidden pt-[4.5rem]">
		<div class="hidden min-w-0 flex-1 md:block" aria-hidden="true"></div>

		<!-- TOC — pulled next to the article column -->
		<aside class="hidden w-52 shrink-0 flex-col border-r border-border bg-card/30 lg:w-56 md:flex">
			<div class="flex items-center gap-2.5 px-4 py-4 border-b border-border">
				<a href="/blog" class="flex items-center gap-2 text-sm text-muted-foreground hover:text-foreground transition-colors">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
					返回博客
				</a>
			</div>
			<div class="flex-1 overflow-y-auto px-3 py-5">
				<p class="mb-3 px-2 text-xs font-semibold uppercase tracking-wider text-muted-foreground">目录</p>
				<nav id="toc-nav" class="space-y-0.5">
					{tocItems.length > 0 ? tocItems.map((item) => (
						<a
							href={`#${item.id}`}
							data-toc-link={item.id}
							class:list={[
								'toc-link block rounded-r-md border-l-2 border-transparent py-1.5 text-sm text-muted-foreground transition-colors hover:text-foreground',
								item.level === 2 ? 'pl-3 font-medium' : 'pl-5',
							]}
						>
							{item.text}
						</a>
					)) : (
						<p class="px-2 text-sm text-muted-foreground">本文暂无目录</p>
					)}
				</nav>
			</div>
			<div class="border-t border-border px-4 py-3">
				<p class="text-xs text-muted-foreground">在博客页用 Ctrl/Cmd + K 搜索</p>
			</div>
		</aside>

		<!-- Article column — same centered max width as before -->
		<div id="article-scroll" class="w-full max-w-4xl shrink overflow-y-auto">
			<div class="px-6 py-8 sm:px-10 sm:py-10">
				<!-- Breadcrumb -->
				<nav class="mb-6 flex items-center gap-2 text-sm text-muted-foreground">
					<a href="/" class="hover:text-foreground">首页</a>
					<span>/</span>
					<a href="/blog" class="hover:text-foreground">博客</a>
					<span>/</span>
					<a href={`/blog?category=${article.category}`} class="hover:text-foreground">{article.category}</a>
				</nav>

				<!-- Header -->
				<header class="mb-8">
					<div class="mb-4 flex items-center gap-3 text-sm">
						<span class="rounded-full bg-primary/10 px-3 py-1 font-medium text-primary">{article.category}</span>
						<span class="text-muted-foreground">{article.date}</span>
						<span class="text-muted-foreground">· {article.readTime}</span>
					</div>
					<h1 class="text-balance text-3xl font-bold leading-tight tracking-tight sm:text-4xl">{article.title}</h1>
					<p class="mt-4 text-lg text-muted-foreground leading-relaxed">{article.excerpt}</p>
					<div class="mt-5 flex flex-wrap gap-2">
						{article.tags.map(tag => (
							<span class="rounded-lg bg-secondary px-2.5 py-1 text-xs text-muted-foreground">#{tag}</span>
						))}
					</div>
				</header>

				<!-- Cover image -->
				<div class="mb-8 overflow-hidden rounded-2xl border border-border">
					<img src={article.cover} alt={article.title} class="aspect-[16/9] w-full object-cover" />
				</div>

				<!-- Content -->
				<div class="prose-content text-foreground" id="article-content" set:html={renderedContent} />

				<!-- Share / Social CTA -->
				<div class="mt-12 rounded-2xl border border-border bg-card p-6">
					<p class="font-semibold">觉得有帮助？关注我的更多内容</p>
					<div class="mt-4 flex flex-wrap gap-3">
						<a href="/about" class="inline-flex items-center gap-2 rounded-xl border border-border px-4 py-2 text-sm hover:bg-secondary transition-colors">
							<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 3.37-4.39V9.5a6.34 6.34 0 0 0-1.05-.1A6.34 6.34 0 0 0 5 20.7a6.34 6.34 0 0 0 10.66-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.3z"/></svg>
							抖音
						</a>
						<a href="/about" class="inline-flex items-center gap-2 rounded-xl border border-border px-4 py-2 text-sm hover:bg-secondary transition-colors">
							<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M8.691 2C4.768 2 1.5 4.671 1.5 8.008c0 1.895 1.097 3.582 2.812 4.683l-.703 2.115 2.461-1.262c.879.175 1.582.351 2.461.351.176 0 .351-.012.526-.024-.109-.351-.176-.714-.176-1.097 0-3.226 2.812-5.851 6.328-5.851.176 0 .351 0 .526.012C15.326 4.418 12.352 2 8.691 2z"/></svg>
							微信公众号
						</a>
						<a href="/about" class="inline-flex items-center gap-2 rounded-xl border border-border px-4 py-2 text-sm hover:bg-secondary transition-colors">
							<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17.813 4.653h.85c1.51.044 2.769.566 3.773 1.674.99 1.08 1.476 2.406 1.476 3.956v6.683c0 1.55-.486 2.876-1.476 3.956-1.004 1.108-2.262 1.63-3.773 1.674H5.237c-1.51-.044-2.769-.566-3.773-1.674C.974 19.842.488 18.516.488 16.966v-6.683c0-1.55.486-2.876 1.476-3.956C2.968 5.219 4.226 4.697 5.737 4.653h.85l-1.42-1.42a.886.886 0 0 1-.273-.645c0-.256.085-.466.273-.645A.886.886 0 0 1 5.8 1.67c.256 0 .466.085.645.273l2.836 2.836h5.438l2.836-2.836a.886.886 0 0 1 .645-.273c.256 0 .466.085.645.273a.886.886 0 0 1 .273.645.886.886 0 0 1-.273.645l-1.42 1.42z"/></svg>
							Bilibili
						</a>
					</div>
				</div>

				<!-- Related -->
				{related.length > 0 && (
					<div class="mt-12 border-t border-border pt-10">
						<h2 class="mb-5 text-xl font-bold">相关文章</h2>
						<div class="grid gap-4 sm:grid-cols-3">
							{related.map(r => (
								<a href={`/blog/${r.slug}`} class="group flex flex-col rounded-xl border border-border bg-card p-4 transition-all hover:border-primary/40 hover:shadow-md">
									<span class="mb-2 text-xs text-primary">{r.category}</span>
									<h3 class="text-sm font-semibold leading-snug transition-colors group-hover:text-primary">{r.title}</h3>
									<p class="mt-1 text-xs text-muted-foreground line-clamp-2">{r.excerpt}</p>
								</a>
							))}
						</div>
					</div>
				)}

				<!-- Back -->
				<div class="mt-8 pb-4">
					<a href="/blog" class="inline-flex items-center gap-2 text-sm text-muted-foreground hover:text-foreground">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
						返回博客
					</a>
				</div>
			</div>
		</div>

		<div class="hidden min-w-0 flex-1 md:block" aria-hidden="true"></div>
	</div>
</Layout>

<style is:global>
	.toc-link.is-active {
		border-left-color: hsl(var(--primary));
		background-color: hsl(var(--primary) / 0.08);
		color: hsl(var(--primary));
		font-weight: 600;
	}

	/* 文章代码块：深色 macOS 窗口风格 */
	.code-window {
		background: #2b2b2b;
		color: #e8e8e8;
	}
	.code-window-bar {
		background: #323232;
		border-bottom: 1px solid rgba(255, 255, 255, 0.06);
	}
	.code-dot {
		display: inline-block;
		width: 10px;
		height: 10px;
		border-radius: 9999px;
	}
	.code-dot-red { background: #ff5f57; }
	.code-dot-yellow { background: #febc2e; }
	.code-dot-green { background: #28c840; }
	.code-lang {
		margin-left: auto;
		font-size: 11px;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: rgba(255, 255, 255, 0.35);
		font-family: "JetBrains Mono", Menlo, Monaco, monospace;
	}
	.code-window-body {
		margin: 0;
		background: transparent;
		color: #e8e8e8;
	}
	.code-window-body code {
		font-family: "JetBrains Mono", Menlo, Monaco, monospace;
		white-space: pre;
	}
	.tok-kw { color: #c678dd; }
	.tok-string { color: #c3e88d; }
	.tok-fn { color: #82aaff; }
	.tok-comment { color: #7f848e; }
</style>

<script>
	const headings = Array.from(document.querySelectorAll('[data-toc]'));
	const tocLinks = Array.from(document.querySelectorAll('[data-toc-link]'));
	const scrollContainer = document.getElementById('article-scroll');

	function setActive(id) {
		tocLinks.forEach((link) => {
			const active = link.getAttribute('data-toc-link') === id;
			link.classList.toggle('is-active', active);
		});
	}

	function getScrollTopFor(target) {
		if (!scrollContainer) return 0;
		const containerRect = scrollContainer.getBoundingClientRect();
		const targetRect = target.getBoundingClientRect();
		return targetRect.top - containerRect.top + scrollContainer.scrollTop - 24;
	}

	function updateActiveFromScroll() {
		if (!scrollContainer || headings.length === 0) return;

		const marker = scrollContainer.getBoundingClientRect().top + 96;
		let activeId = headings[0].id;

		for (const heading of headings) {
			if (heading.getBoundingClientRect().top <= marker) {
				activeId = heading.id;
			} else {
				break;
			}
		}

		setActive(activeId);
	}

	if (headings.length > 0 && tocLinks.length > 0 && scrollContainer) {
		scrollContainer.addEventListener('scroll', updateActiveFromScroll, { passive: true });
		updateActiveFromScroll();

		tocLinks.forEach((link) => {
			link.addEventListener('click', (e) => {
				e.preventDefault();
				const id = link.getAttribute('data-toc-link');
				if (!id) return;
				const target = document.getElementById(id);
				if (!target) return;

				scrollContainer.scrollTo({
					top: getScrollTopFor(target),
					behavior: 'smooth',
				});
				setActive(id);
				history.replaceState(null, '', `#${id}`);
			});
		});

		// Honor hash on load
		const hash = decodeURIComponent(location.hash.slice(1));
		if (hash) {
			const target = document.getElementById(hash);
			if (target) {
				requestAnimationFrame(() => {
					scrollContainer.scrollTo({ top: getScrollTopFor(target) });
					setActive(hash);
				});
			}
		}
	}
</script>
