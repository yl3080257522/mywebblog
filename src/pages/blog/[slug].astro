<script type="application/json" id="rt-search-index" set:html={JSON.stringify(searchIndex)} />

<script>
	const headings = Array.from(document.querySelectorAll('[data-toc]'));
	const tocLinks = Array.from(document.querySelectorAll('[data-toc-link]'));
	let tocClickLock = false;
	let tocClickLockTimer = 0;

	// —— 侧边栏文章搜索 ——
	(function initSidebarSearch() {
		const input = document.getElementById('rt-post-search');
		const clearBtn = document.getElementById('rt-search-clear');
		const resultsEl = document.getElementById('rt-search-results');
		const indexEl = document.getElementById('rt-search-index');
		if (!input || !clearBtn || !resultsEl || !indexEl) return;

		let posts = [];
		try {
			posts = JSON.parse(indexEl.textContent || '[]');
		} catch {
			posts = [];
		}

		function escapeHtml(s) {
			return String(s)
				.replace(/&/g, '&amp;')
				.replace(/</g, '&lt;')
				.replace(/>/g, '&gt;')
				.replace(/"/g, '&quot;');
		}

		function highlight(text, query) {
			const safe = escapeHtml(text);
			if (!query) return safe;
			const escaped = query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
			return safe.replace(new RegExp(`(${escaped})`, 'gi'), '<mark>$1</mark>');
		}

		function scorePost(a, q) {
			const title = a.title.toLowerCase();
			const excerpt = a.excerpt.toLowerCase();
			let score = 0;
			if (title === q) score += 100;
			if (title.includes(q)) score += 40;
			if (a.tags.some((t) => t.toLowerCase().includes(q))) score += 25;
			if (excerpt.includes(q)) score += 10;
			if (a.sameCategory) score += 8;
			score += Math.min(a.sharedTags, 3) * 5;
			return score;
		}

		function render(query) {
			const q = query.trim().toLowerCase();
			clearBtn.hidden = !query;

			if (!q) {
				resultsEl.hidden = true;
				resultsEl.innerHTML = '';
				return;
			}

			const hits = posts
				.filter((a) => aIncludes(a, q))
				.map((a) => ({ a, score: scorePost(a, q) }))
				.sort((x, y) => {
					if (y.score !== x.score) return y.score - x.score;
					if (y.a.sameCategory !== x.a.sameCategory) return y.a.sameCategory ? 1 : -1;
					return y.a.sharedTags - x.a.sharedTags;
				})
				.slice(0, 8);

			resultsEl.hidden = false;
			if (hits.length === 0) {
				resultsEl.innerHTML = '<p class="rt-search-empty">未找到相关帖子</p>';
				return;
			}

			resultsEl.innerHTML = hits.map(({ a }) => `
				<a class="rt-search-hit" href="/blog/${escapeHtml(a.slug)}" role="option">
					<span class="rt-search-hit-cat">${escapeHtml(a.category)}</span>
					<span class="rt-search-hit-title">${highlight(a.title, query.trim())}</span>
				</a>
			`).join('');
		}

		function aIncludes(a, q) {
			return (
				a.title.toLowerCase().includes(q) ||
				a.excerpt.toLowerCase().includes(q) ||
				a.tags.some((t) => t.toLowerCase().includes(q)) ||
				a.category.toLowerCase().includes(q)
			);
		}

		let timer = 0;
		input.addEventListener('input', () => {
			clearTimeout(timer);
			timer = window.setTimeout(() => render(input.value), 100);
		});
		clearBtn.addEventListener('click', () => {
			input.value = '';
			render('');
			input.focus();
		});
	})();

	function setActive(id) {
		tocLinks.forEach((link) => {
			link.classList.toggle('is-active', link.getAttribute('data-toc-link') === id);
		});
	}

	function updateActiveFromScroll() {
		if (headings.length === 0 || tocClickLock) return;
		const marker = 120;
		const doc = document.documentElement;
		const nearBottom = window.scrollY + window.innerHeight >= doc.scrollHeight - 100;
		// 滚到页底时末节往往到不了 marker，强制高亮最后一项
		if (nearBottom) {
			setActive(headings[headings.length - 1].id);
			return;
		}
		let activeId = headings[0].id;
		for (const heading of headings) {
			if (heading.getBoundingClientRect().top <= marker) activeId = heading.id;
			else break;
		}
		setActive(activeId);
	}

	if (headings.length > 0 && tocLinks.length > 0) {
		window.addEventListener('scroll', updateActiveFromScroll, { passive: true });
		updateActiveFromScroll();
		tocLinks.forEach((link) => {
			link.addEventListener('click', (e) => {
				e.preventDefault();
				const id = link.getAttribute('data-toc-link');
				if (!id) return;
				const target = document.getElementById(id);
				if (!target) return;
				const top = target.getBoundingClientRect().top + window.scrollY - 96;
				tocClickLock = true;
				clearTimeout(tocClickLockTimer);
				setActive(id);
				history.replaceState(null, '', `#${id}`);
				window.scrollTo({ top, behavior: 'smooth' });
				tocClickLockTimer = window.setTimeout(() => {
					tocClickLock = false;
					updateActiveFromScroll();
				}, 700);
			});
		});
		const hash = decodeURIComponent(location.hash.slice(1));
		if (hash) {
			const target = document.getElementById(hash);
			if (target) {
				requestAnimationFrame(() => {
					window.scrollTo({ top: target.getBoundingClientRect().top + window.scrollY - 96 });
					setActive(hash);
				});
			}
		}
	}

	const qqBtn = document.getElementById('btn-open-qq');
	const wxBtn = document.getElementById('btn-wechat-tip');
	const tipModal = document.getElementById('wechat-tip-modal');
	const tipClose = document.getElementById('btn-close-tip');
	const qqGroup = '1013137874';

	qqBtn?.addEventListener('click', () => {
		const isMobile = /Android|iPhone|iPad|iPod/i.test(navigator.userAgent);
		if (isMobile) {
			window.location.href = `mqqapi://card/show_pslcard?src_type=internal&version=1&uin=${encodeURIComponent(qqGroup)}&card_type=group&source=qrcode`;
		} else {
			alert(`QQ 群号：${qqGroup}（可复制到 QQ 搜索加群）`);
		}
	});

	wxBtn?.addEventListener('click', () => tipModal?.classList.add('is-open'));
	tipClose?.addEventListener('click', () => tipModal?.classList.remove('is-open'));
	tipModal?.addEventListener('click', (e) => {
		if (e.target === tipModal) tipModal.classList.remove('is-open');
	});

	// 图片 / GIF 灯箱放大
	const lightbox = document.getElementById('rt-lightbox');
	const lightboxImg = document.getElementById('rt-lightbox-img');
	const lightboxClose = document.getElementById('rt-lightbox-close');
	const openLightbox = (img) => {
		if (!lightbox || !lightboxImg) return;
		lightboxImg.src = img.currentSrc || img.src;
		lightboxImg.alt = img.alt || '';
		lightbox.classList.add('is-open');
		document.body.style.overflow = 'hidden';
	};
	const closeLightbox = () => {
		lightbox?.classList.remove('is-open');
		document.body.style.overflow = '';
		if (lightboxImg) lightboxImg.removeAttribute('src');
	};
	document.getElementById('article-content')?.addEventListener('click', (e) => {
		const img = e.target?.closest?.('.rt-fig-img, .rt-fig-pair img, .rt-card-logo img');
		if (!img) return;
		e.preventDefault();
		openLightbox(img);
	});
	lightboxClose?.addEventListener('click', (e) => {
		e.stopPropagation();
		closeLightbox();
	});
	lightbox?.addEventListener('click', (e) => {
		if (e.target === lightbox) closeLightbox();
	});
	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && lightbox?.classList.contains('is-open')) closeLightbox();
	});
</script>
