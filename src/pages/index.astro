---
import Layout from '../layouts/Layout.astro';
import ProjectCarousel from '../components/ProjectCarousel';
import OceanHero from '../components/hero/OceanHero';
import { articles, categories } from '../data/articles';

const feed = [...articles].sort((a, b) => b.date.localeCompare(a.date));
const popular = [
  ...articles.filter((a) => a.featured),
  ...articles.filter((a) => !a.featured),
].slice(0, 8);

const tagCloud = Array.from(
  new Set(articles.flatMap((a) => a.tags)),
).slice(0, 12);
---

<Layout
	title="生信知识专栏 · 个人博客"
	description="R语言与生信教程知识专栏：聚焦前沿的Codex学习R语言进行实战，以及基础知识内容分享：零基础安装、RStudio 到转录组分析、单细胞分析实战，系统性介绍R语言学习过程中的经历，项目实战，SCI文献日常分享，帮助大家初步理解知识。"
>
	<!-- Compact hero -->
	<section class="relative overflow-hidden bg-[#c5e5f5]">
		<div
			class="pointer-events-none absolute inset-0"
			aria-hidden
			style="background:
				radial-gradient(ellipse 70% 60% at 75% 35%, #dff2fb 0%, transparent 55%),
				radial-gradient(ellipse 50% 40% at 20% 80%, #a8d4ea 0%, transparent 50%),
				linear-gradient(180deg, #d4eaf6 0%, #b6d9ec 55%, #9ec9e0 100%);"
		></div>

		<div class="relative z-10 mx-auto grid max-w-6xl items-center gap-6 px-4 pb-10 pt-24 sm:px-6 sm:pb-12 sm:pt-28 lg:grid-cols-[1.05fr_0.95fr] lg:gap-4 lg:pb-8">
			<div class="animate-fade-up text-[hsl(var(--ink))] lg:pr-4">
				<p class="font-display text-4xl font-bold tracking-tight sm:text-5xl md:text-6xl">
					知识专栏
				</p>
				<span class="mt-4 block h-1 w-14 bg-[hsl(var(--accent))] animate-reveal-line"></span>
				<h1 class="mt-5 max-w-md text-balance text-lg font-medium leading-snug tracking-tight text-[hsl(var(--ink)_/_0.88)] sm:text-xl md:text-2xl">
					生物信息 · R语言 · AI前沿 · 个人知识专栏
				</h1>
				<p class="mt-3 max-w-sm text-sm leading-relaxed text-[hsl(var(--ink)_/_0.55)] sm:text-base">
					用代码解读肿瘤机制，用实践打通知识壁垒 — 个人知识积累的一个记录型博客。
				</p>
				<div class="mt-6 flex flex-wrap items-center gap-3">
					<a
						href="#articles"
						class="inline-flex items-center gap-2 rounded-xl bg-primary px-5 py-3 text-sm font-semibold text-primary-foreground transition-transform hover:scale-[1.02]"
					>
						阅读文章
					</a>
					<a
						href="/projects"
						class="inline-flex items-center gap-2 rounded-xl border border-[hsl(var(--ink)_/_0.12)] bg-white/55 px-5 py-3 text-sm font-semibold text-[hsl(var(--ink))] backdrop-blur-sm transition-colors hover:bg-white/85"
					>
						项目实战
					</a>
				</div>
			</div>

			<div class="relative mx-auto h-[280px] w-full max-w-[360px] sm:h-[340px] lg:mx-0 lg:h-[380px] lg:max-w-none">
				<OceanHero client:load />
			</div>
		</div>

		<div class="pointer-events-none relative z-20 -mb-px leading-none" aria-hidden>
			<svg viewBox="0 0 1440 90" preserveAspectRatio="none" class="block h-[56px] w-full sm:h-[72px]">
				<path fill="hsl(var(--background))" d="M0,50 C280,90 480,10 720,45 C980,82 1200,20 1440,55 L1440,90 L0,90 Z"></path>
			</svg>
		</div>
	</section>

	<!-- Articles + sidebar (Josh Comeau style) -->
	<section id="articles" class="bg-background py-12 sm:py-16">
		<div class="mx-auto grid max-w-6xl gap-12 px-4 sm:px-6 lg:grid-cols-[minmax(0,1fr)_280px] lg:gap-16">
			<!-- Left: article feed -->
			<div>
				<p class="text-sm font-bold tracking-wide text-[hsl(var(--accent))]">文章和教程</p>

				<div class="mt-8 space-y-12">
					{feed.map((article) => (
						<article>
							<a href={`/blog/${article.slug}`} class="group block">
								<h2 class="font-display text-2xl font-bold tracking-tight text-foreground transition-colors group-hover:text-primary sm:text-[1.65rem]">
									{article.title}
								</h2>
								{article.tags[0] && (
									<p class="mt-2 text-base font-semibold text-foreground/75">
										{article.tags.slice(0, 2).join(' · ')}
									</p>
								)}
								<p class="mt-3 max-w-2xl text-[15px] leading-relaxed text-foreground/70">
									{article.excerpt}
								</p>
								<span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-primary transition-transform group-hover:translate-x-0.5">
									阅读更多
									<span aria-hidden>→</span>
								</span>
							</a>
						</article>
					))}
				</div>

				<div class="mt-14">
					<a
						href="/blog"
						class="text-sm font-semibold text-primary hover:underline"
					>
						查看全部文章 →
					</a>
				</div>
			</div>

			<!-- Right: sidebar -->
			<aside class="space-y-12 lg:pt-1">
				<div>
					<p class="text-sm font-bold tracking-wide text-[hsl(var(--accent))]">按类别浏览</p>
					<div class="mt-4 flex flex-wrap gap-2">
						{categories.map((cat) => (
							<a
								href={`/blog?category=${cat.name}`}
								class="rounded-lg bg-[#d7ebf5] px-3.5 py-1.5 text-sm font-medium text-[#1e4a63] transition-colors hover:bg-[#c5e0ef]"
							>
								{cat.name}
							</a>
						))}
						{tagCloud.slice(0, 6).map((tag) => (
							<a
								href={`/blog?q=${encodeURIComponent(tag)}`}
								class="rounded-lg bg-[#d7ebf5] px-3.5 py-1.5 text-sm font-medium text-[#1e4a63] transition-colors hover:bg-[#c5e0ef]"
							>
								{tag}
							</a>
						))}
					</div>
				</div>

				<div>
					<p class="text-sm font-bold tracking-wide text-[hsl(var(--accent))]">热门内容</p>
					<ul class="mt-4 space-y-3.5">
						{popular.map((article) => (
							<li>
								<a
									href={`/blog/${article.slug}`}
									class="group flex items-start gap-2 text-[15px] leading-snug text-foreground transition-colors hover:text-primary"
								>
									<span class="mt-0.5 shrink-0 text-primary" aria-hidden>→</span>
									<span>{article.title}</span>
								</a>
							</li>
						))}
					</ul>
				</div>
			</aside>
		</div>
	</section>
</Layout>
